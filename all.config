# For `KCONFIG_ALLCONFIG` in the `allmodconfig` and `allyesconfig` jobs.

# Otherwise `RUST` would not get enabled: RISC-V because
# `HAVE_CFI_ICALL_NORMALIZE_INTEGERS_RUSTC` depends on `ARM64 || X86_64`, and the
# rest because `HAVE_CFI_ICALL_NORMALIZE_INTEGERS` needs Clang >= 19.1.3 together
# with `GCOV_KERNEL` or `KASAN`, and Ubuntu 24.04 has Clang 18.
# CONFIG_CFI is not set

# It needs `hexdump` in `Makefile.zboot`, and it does not build the `Image.gz` that
# we expect in arm64.
# CONFIG_EFI_ZBOOT is not set

# Modules only get signed in `modules_install`, so they could not be loaded.
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_IMA_APPRAISE_REQUIRE_MODULE_SIGS is not set

# It would build for the CPU of the runner, which QEMU may not emulate.
# CONFIG_X86_NATIVE_CPU is not set

# The boot test needs these built-in, but `allmodconfig` would make them modules:
# `/init` is a script and the serial console is where we get the log from.
CONFIG_BINFMT_SCRIPT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_AMBA_PL011=y
